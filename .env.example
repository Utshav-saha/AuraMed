# ── AuraMed backend environment variables ──
# Copy to .env (or export in your shell) and fill in real values.

# Database / Supabase
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI
GEMINI_API_KEY=

# ── Authentication (added for the auth feature) ──
# Secret used to sign JWT access tokens. Generate with:  openssl rand -base64 32
JWT_SECRET=

# Google OAuth 2.0 Client ID (Web). Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the
# frontend. Leave empty to keep email/password auth only; /api/v1/auth/google will
# return 503 until this is set.
GOOGLE_CLIENT_ID=
