# AuraMed backend env. Copy to app/.env

SUPABASE_URL=
SUPABASE_KEY=            # service_role key
DATABASE_URL=postgresql://user:password@host:6543/postgres   # pooler port thik ache, code e statement cache off

GEMINI_API_KEY=
GEMINI_API_KEY2=         # optional, OCR er jonno alada key; na dile GEMINI_API_KEY use hoy
GEMINI_MODEL=gemini-2.5-flash

JWT_SECRET=              # openssl rand -base64 32
